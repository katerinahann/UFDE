# Copy into environment-specific secret storage. Never commit a populated .env.
# Next.js PUBLIC values: these are intentionally visible in browser bundles.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_IMAGE_HOSTS=

# Server-only API and Vercel proxy addresses; use HTTPS URLs in production.
API_INTERNAL_URL=http://localhost:4000/v1
ADMIN_BACKEND_URL=http://localhost:4000/v1/admin
CONTACT_BACKEND_URL=http://localhost:4000/v1/contact
NEWSLETTER_BACKEND_URL=http://localhost:4000/v1/newsletter

# NestJS. Local example only: provision real credentials through a secret manager.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ufde:local-development-only@localhost:5432/ufde
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true
LEGAL_APPROVED=false
ENABLE_SWAGGER=false
# Generate independent random secrets (at least 48 characters).
CONTACT_RATE_SECRET=
# Same secret on the Vercel proxies and Nest API; never NEXT_PUBLIC_.
CONTACT_PROXY_SECRET=

# Opaque database-backed sessions are used; no JWT secret is required.
# Passwords are scrypt hashes; create accounts through the admin:create script.
# Mail credentials stay exclusively on the API server. SMTP is not used.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Contact recipient is fixed to institut.ufde@gmail.com in institute configuration.
NEWSLETTER_DOUBLE_OPT_IN=false

# Development uploads. Production must use S3-compatible object storage.
MEDIA_STORAGE=local
MEDIA_DIRECTORY=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
